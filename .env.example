# Kalshi API Configuration
KALSHI_ENV=demo
KALSHI_API_KEY=your_api_key_here
KALSHI_PRIVATE_KEY_PATH=kalshi_private_key_demo.pem

# Strategy Tuning Parameters
RISK_GAMMA=0.5
MIN_SPREAD=4
ORDER_SIZE=1
ORDER_DOLLARS=1.00
MAX_ORDER_CONTRACTS=100
MAX_HEDGE_INVENTORY=250
TARGET_TICKER=NFL
MAX_EXPIRATION_DAYS=8
MIN_MID_PRICE=10
MAX_MID_PRICE=90
MIN_TIME_TO_CLOSE_SECONDS=3600

# Alerting
ALERT_WEBHOOK_URL=

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kalshi_bot
DB_USER=postgres
DB_PASSWORD=postgres
