# Kalshi API Configuration
KALSHI_ENV=demo
KALSHI_API_KEY=your_api_key_here
KALSHI_PRIVATE_KEY_PATH=kalshi_private_key_demo.pem

# Strategy Tuning Parameters
RISK_GAMMA=0.5
MIN_SPREAD=4
ORDER_SIZE=1
TARGET_TICKER=NFL

# Alerting
ALERT_WEBHOOK_URL=

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kalshi_bot
DB_USER=postgres
DB_PASSWORD=postgres
